{
  "$schema": "./node_modules/knip/schema.json",
  "entry": [
    "src/worker.ts",
    "src/restore.ts",
    "src/vmValidateSmoke.ts",
    "src/ui/app.tsx",
    "src/stryker-tap.cjs",
    "scripts/**/*.{js,mjs,ts}",
    "extension/tracker.ts",
    ".agents/skills/llm-to-code/scripts/profile-session.ts"
  ],
  "ignoreBinaries": [
    "tailscale",
    "ssh-keygen",
    "mkfifo",
    "openssl",
    "setsid",
    "script"
  ],
  "ignoreDependencies": [
    "@stryker-mutator/api",
    "@hughescr/stryker-bun-runner",
    "@stryker-mutator/bun-runner"
  ],
  "ignoreUnresolved": ["src/server.ts"],
  "rules": {
    "exports": "warn",
    "types": "warn"
  }
}
